# Test fragment: catch heap corruption where it happens. Every block gets canaries and
# is filled on alloc/free; a damaged one aborts with its address ("CORRUPT HEAP").
# (Not CONFIG_HEAP_TASK_TRACKING: on IDF 5.5.1 with Wi-Fi it deadlocks in free() at the
# first WiFi.begin, tested on the Max.)
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
