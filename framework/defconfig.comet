# Comet's changes to the Arduino-ESP32 2.0.17 framework (ESP-IDF v4.4.7), applied
# on top of the lib-builder's own defconfigs for the ESP32-S3. Built by
# .github/workflows/framework.yml; see framework/README.md for why each is here.

# TCP receive window and send buffer: 5760 bytes (4 segments) capped any download
# over the internet at ~130 KB/s. 32 KB lets 22 segments be in flight. The pbufs
# come from PSRAM (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP, already on).
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_RX_BA_WIN=16

# Wi-Fi TX buffers allocated when sent (from PSRAM) instead of 8 static ones held in
# internal RAM all the time (~13 KB).
# CONFIG_ESP32_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# Let big zero-initialised globals live in PSRAM (EXT_RAM_BSS_ATTR): the UI keeps
# tens of KB of tables there that never need internal RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
