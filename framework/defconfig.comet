# Comet's changes to the Arduino-ESP32 2.0.17 framework (ESP-IDF v4.4.7), applied
# on top of the lib-builder's own defconfigs for the ESP32-S3. Built by
# .github/workflows/framework.yml; see framework/README.md for why each is here.

# TCP as in Espressif's own ESP32-S3 throughput example (esp-idf
# examples/wifi/iperf/sdkconfig.defaults.esp32s3). The stock 5760-byte TCP buffers
# (4 segments) capped any download over the internet at ~130 KB/s; a user report on
# the ESP32-S3 saw 3 -> 22 Mbit/s from this change alone. The pbufs and the dynamic
# RX buffers come from PSRAM (CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP, already on), so
# the larger numbers cost PSRAM, not internal RAM.
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=64

# Left as they are, on purpose:
# - The 8 static RX buffers (internal RAM, ~1.6 KB each) and the RX block-ack window
#   of 16: Espressif's example uses 16 static buffers, which would cost another
#   ~13 KB of internal RAM.
# - The TX buffers: dynamic ones cannot be chosen while SPIRAM_USE_MALLOC is on
#   (esp_wifi Kconfig), and Arduino needs that; with TRY_ALLOCATE_WIFI_LWIP the
#   frames already go out by reference from PSRAM.
# - Wi-Fi and lwIP IRAM optimisations: throughput bought with internal RAM.

# Let big zero-initialised globals live in PSRAM (EXT_RAM_BSS_ATTR): the UI keeps
# tens of KB of tables that never need internal RAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
